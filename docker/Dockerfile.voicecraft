# VoiceCraft image of Table 2 ("voicecraft-image"), reconstructed from its build log.
# The original cloned VoiceCraft at HEAD (2026-07-11); that commit is pinned below.
# Build: docker build -f docker/Dockerfile.voicecraft -t voicecraft-image:latest docker
FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime@sha256:e4aaefef0c96318759160ff971b527ae61ee306a1204c5f6e907c4b45f05b8a3
RUN apt-get update && apt-get install -y --no-install-recommends     git espeak-ng ffmpeg wget ca-certificates     && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir     audiocraft==1.0.0     phonemizer==3.2.1     openai-whisper     huggingface_hub     soundfile     num2words
RUN pip install --no-cache-dir torch==2.1.0 torchaudio==2.1.0     --index-url https://download.pytorch.org/whl/cu121
RUN git clone https://github.com/jasonppy/VoiceCraft /opt/VoiceCraft && git -C /opt/VoiceCraft checkout f0a7a971363905883a21c466a3aa4ea2d4c0b690
WORKDIR /mnt
