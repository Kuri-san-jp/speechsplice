# Main image of the SpeechSplice experiments ("my-lab-image:latest").
#
# Everything except Irodori-TTS, XTTS-v2 and VoiceCraft ran in this image: T5Gemma-TTS,
# SpeechT5, LongCat-AudioDiT, Kiseki-TTS, Qwen3-TTS, Llasa-3B, CSM-1B, Bark, EdiTTS, and
# all scorers. The original Dockerfile was not preserved; this file reconstructs it,
# step by step and in order, from the BuildKit log of the 2026-07-11 build (35 steps).
# The image built on 2026-07-11 is the one behind the outputs of July onward; runs of
# May 2026 used an earlier build of the same file.
# my_lab_image_freeze.txt is the `pip freeze` of that image as it ran the experiments,
# and pins every package that the unpinned lines below resolved to.
#
# Two steps are left out because they install packages that no experiment of the paper
# uses and need a helper file that was not preserved (audiolm-pytorch / spear-tts-pytorch
# with a local patch). Steps whose packages are unused by the paper (texlive, anthropic,
# outetts, snac, ...) are kept so that the dependency resolution matches the original.
#
# Build:  docker build -f docker/Dockerfile.main -t my-lab-image:latest docker
# Run:    docker run --gpus all -v "$PWD":/mnt -w /mnt my-lab-image:latest python3 ...
#         (the scripts detect /mnt/scripts and use /mnt as the repository root)

FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime@sha256:c8268a92a69bd500f8be0e665b2630ee006dadaf7bfbc24249141b15ff622755
RUN apt-get update && apt-get install -y git ffmpeg gcc g++ cmake espeak-ng && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y     pandoc     texlive-xetex     texlive-latex-extra     texlive-lang-cjk     texlive-fonts-recommended     texlive-fonts-extra     fonts-noto-cjk     && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.6.0 torchaudio==2.6.0 torchvision==0.21.0 --index-url https://download.pytorch.org/whl/cu124
RUN pip install --no-cache-dir pandas scikit-learn matplotlib pytest
RUN pip install --no-cache-dir     transformers==4.57.3     sentencepiece     soundfile     librosa     ffmpeg-python     fire     einops     omegaconf==2.3.0     langdetect     "gradio>=4.0.0,<6.0.0"
RUN pip install --no-cache-dir peft datasets accelerate bitsandbytes
# pyopenjtalk is a dependency of the T5Gemma-TTS inference code (its duration estimator
# counts Japanese phonemes with it); our own code does not import it.
RUN pip install --no-cache-dir wandb tensorboard torchmetrics g2p_en pypinyin pyopenjtalk
RUN python -c "import pyopenjtalk; pyopenjtalk.tts('テスト')"
RUN pip install --no-cache-dir openai-whisper
RUN pip install --no-cache-dir vector-quantize-pytorch torchtune torchao
RUN pip install --no-cache-dir --no-deps https://huggingface.co/NandemoGHS/Anime-XCodec2-44.1kHz-v2/resolve/main/xcodec2-0.1.7.tar.gz
RUN pip install --no-cache-dir     conformer==0.3.2     diffusers==0.29.0     gdown==5.1.0     hydra-core==1.3.2     HyperPyYAML==1.2.2     inflect==7.3.1     lightning==2.2.4     modelscope==1.20.0     "numpy==1.26.4"     onnx==1.16.0     pyworld==0.3.4     wetext==0.0.4     wget==3.2     x-transformers==2.11.24
RUN pip install --no-cache-dir qwen-omni-utils
RUN pip install --no-cache-dir git+https://github.com/huggingface/transformers@main
RUN pip install --no-cache-dir qwen-tts sentence-transformers
RUN pip install --no-cache-dir anthropic
RUN pip install --no-cache-dir pykakasi
RUN pip install --no-cache-dir snac
RUN pip install --no-cache-dir outetts
RUN pip install --no-cache-dir pyloudnorm
RUN pip install --no-cache-dir phonemizer
RUN python -c "from phonemizer import phonemize; print(phonemize('hello world', language='en-us', backend='espeak'))"
RUN python -c "import nltk; nltk.download('averaged_perceptron_tagger', download_dir='/opt/conda/nltk_data'); nltk.download('averaged_perceptron_tagger_eng', download_dir='/opt/conda/nltk_data'); nltk.download('cmudict', download_dir='/opt/conda/nltk_data')"
RUN pip install --no-cache-dir pysptk pymcd
RUN pip install --no-cache-dir beartype speechtokenizer
RUN pip install --no-cache-dir git+https://github.com/lifeiteng/naturalspeech3_facodec.git
# (steps 28-29 of the original build, audiolm-pytorch / spear-tts-pytorch with a local patch, are omitted)
RUN pip uninstall -y onnxruntime 2>/dev/null;     pip install --no-cache-dir --no-deps onnxruntime-gpu==1.21.0
RUN pip uninstall -y transformers kernels || true
RUN pip uninstall -y torchao || true
RUN pip install --no-cache-dir torchao==0.9.0
RUN pip install --no-cache-dir transformers==4.57.3
WORKDIR /mnt
